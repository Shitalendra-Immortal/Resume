# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Secret (generate a random 64-char hex string)
JWT_SECRET=your-random-secret-here

# Email Configuration (for contact form notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
NOTIFY_EMAIL=your-email@gmail.com

# Resend HTTPS email API (required on hosts like Render that block SMTP ports).
# Sign up at resend.com with your NOTIFY_EMAIL address, create an API key,
# and set it here / in your host's environment variables.
RESEND_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=*

# Admin Credentials (for dashboard login)
ADMIN_EMAIL=admin@yourdomain.dev
ADMIN_PASSWORD=your-secure-password
